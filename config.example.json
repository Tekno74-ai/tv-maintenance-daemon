    { "name": "Apple TV",        "pkg": "com.apple.atve.androidtv.appletv",  "activity": "com.apple.atve.androidtv.appletv/.MainActivity" },
    { "name": "Disney+",         "pkg": "com.disney.disneyplus" },
    { "name": "HBO Max",         "pkg": "com.wbd.stream",                    "activity": "com.wbd.stream/com.wbd.beam.BeamActivity" },
    { "name": "Prime Video",     "pkg": "com.amazon.amazonvideo.livingroom" },
    { "name": "Projectivy",      "pkg": "com.spocky.projengmenu",            "activity": "com.spocky.projengmenu/.ui.home.MainActivity" }
